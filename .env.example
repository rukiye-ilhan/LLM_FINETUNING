# Optional Hugging Face token for faster downloads / higher rate limits
HF_TOKEN=

# Optional runtime environment label
APP_ENV=local

# DataOps input configuration
COUNSEL_RAW_PATH=data/raw/counsel_revised_zero_data_loss.xlsx
COUNSEL_RAW_SHEET=rag_ready
COUNSEL_DROP_ARTIFACTS=false

# RAG runtime configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=counsel_rag
HF_LOCAL_FILES_ONLY=true
TOP_K=4
MAX_NEW_TOKENS=120

# Options: always, first_turn_only, first_turn_or_topic_shift, never
RAG_RETRIEVAL_POLICY=first_turn_only
RAG_ALLOW_EXPLICIT_TOPIC_SHIFT=true
CHAT_HISTORY_MESSAGE_LIMIT=24
PROMPT_HISTORY_MESSAGE_LIMIT=10

# Optional future OpenAI-compatible LLM endpoint configs
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
